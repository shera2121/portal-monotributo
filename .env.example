# ==============================================================================
# VARIABLES DE ENTORNO PARA VERCEL (OPCIONALES)
# ==============================================================================
# Si preferís configurar estas opciones desde Vercel en lugar de editar src/config.js:
#
# 1. URL de tu Web App de Google Apps Script (termina en /exec)
VITE_APPS_SCRIPT_URL=https://script.google.com/macros/s/TU_ID_DE_SCRIPT/exec
#
# 2. Modo prueba ("true" para datos de demostración, "false" para datos reales)
VITE_USE_MOCK_DATA=true
